{
  "name": "@vlv/api",
  "version": "0.0.0",
  "private": true,
  "description": "API VLV (NestJS) : règles métier, accès aux données, authentification",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
