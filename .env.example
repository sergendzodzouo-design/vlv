# Copie ce fichier en .env puis remplace les valeurs.
# Le fichier .env n'est JAMAIS enregistré dans Git.

# Contrôle du certificat SSL de la base : "verify" (défaut, obligatoire en production)
# ou "no-verify" (développement uniquement : le certificat n'est pas vérifié).
DATABASE_SSL=no-verify

# Port de l'API (défaut : 3001) et taille du pool de connexions (défaut : 5, maximum : 15).
# PORT=3001
# DATABASE_POOL_MAX=5
