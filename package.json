{
  "name": "vlv-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Plateforme VLV de vente et de location de véhicules au Congo-Brazzaville",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:check": "node --env-file=.env scripts/db-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
